[
 {
  "text": "Most cities put up signs to tell you where things are.",
  "start": 1.3,
  "end": 4.063,
  "cue": "L01"
 },
 {
  "text": "Las Vegas did it backwards.",
  "start": 4.55,
  "end": 6.349,
  "cue": "L02"
 },
 {
  "text": "In May of 1905,",
  "start": 6.85,
  "end": 8.540000000000001,
  "cue": "L03"
 },
 {
  "text": "the railroad auctioned off lots in the middle of the Mojave.",
  "start": 8.58,
  "end": 11.912,
  "cue": "L03"
 },
 {
  "text": "By 1932,",
  "start": 13.2,
  "end": 14.47,
  "cue": "L04"
 },
 {
  "text": "the biggest sign in town was a neon beer stein,",
  "start": 14.51,
  "end": 17.53,
  "cue": "L04"
 },
 {
  "text": "pouring light over Fremont Street.",
  "start": 17.57,
  "end": 19.574,
  "cue": "L04"
 },
 {
  "text": "Then came the sign wars.",
  "start": 20.4,
  "end": 22.0,
  "cue": "L05"
 },
 {
  "text": "The Stardust wrapped its whole front in 11,000 bulbs.",
  "start": 22.04,
  "end": 25.445,
  "cue": "L05"
 },
 {
  "text": "The Dunes answered with a pylon 180 feet tall.",
  "start": 28.2,
  "end": 31.435000000000002,
  "cue": "L06"
 },
 {
  "text": "Crews rode an elevator up inside its leg.",
  "start": 31.475,
  "end": 34.379,
  "cue": "L06"
 },
 {
  "text": "Then, one by one, the giants came down.",
  "start": 37.0,
  "end": 40.447,
  "cue": "L07"
 },
 {
  "text": "The lucky ones went to the boneyard.",
  "start": 42.6,
  "end": 44.78,
  "cue": "L08"
 },
 {
  "text": "In 2023,",
  "start": 47.8,
  "end": 49.115,
  "cue": "L09"
 },
 {
  "text": "the biggest sign in town became the building.",
  "start": 49.155,
  "end": 51.910000000000004,
  "cue": "L09"
 },
 {
  "text": "Its first words:",
  "start": 51.95,
  "end": 53.321,
  "cue": "L09"
 },
 {
  "text": "“Hello, World.”",
  "start": 54.0,
  "end": 55.405,
  "cue": "L10"
 },
 {
  "text": "This is how Las Vegas built itself out of light.",
  "start": 56.1,
  "end": 58.887,
  "cue": "L11"
 }
]